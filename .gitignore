# Credenciais de deploy (SFTP HostGator)
.env
.env.*
deploy.conf
*.pem
*.key

# Senha do painel. O repositório é público — este arquivo NUNCA entra.
# Fica em dados/ porque a cliente troca a senha pelo painel e o PHP grava nele.
dados/senha.php

# Conteúdo criado pela cliente no painel — vive no servidor, nunca no repo.
# Os .htaccess destas pastas são exceção: são proteção, não conteúdo, e
# precisam ser versionados e enviados no deploy.
dados/ofertas/*
!dados/ofertas/.gitkeep
dados/backups/
dados/cliques/
dados/tentativas-*.json
assets/videos/*
!assets/videos/.htaccess
assets/img/uploads/*
!assets/img/uploads/.htaccess

# Documentos internos de trabalho — o repositório é público
CLAUDE.md
PROJETO.md

# Sistema / editor
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
.vscode/
.idea/

# Artefatos locais
node_modules/
/tmp/
