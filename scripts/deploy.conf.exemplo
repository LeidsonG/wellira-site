# Credenciais do deploy — copie para deploy.conf na RAIZ do projeto.
#
# deploy.conf está no .gitignore. Nunca versione o arquivo preenchido.
#
# A autenticação é por chave SSH. Não há senha em lugar nenhum: gere o par com
#   ssh-keygen -t ed25519 -f ~/.ssh/wellira_deploy -N ""
# e importe a chave PÚBLICA no cPanel (Acesso SSH → Importar → Autorizar).

SSH_USUARIO="usuario-do-cpanel"
SSH_HOST="wellira.online"
SSH_PORTA="2222"
SSH_CHAVE="~/.ssh/wellira_deploy"

# Raiz pública do site, em caminho ABSOLUTO — o SFTP entra na home do usuário,
# não em /, então "/public_html" não existe do ponto de vista dele.
#   Domínio principal → /home3/USUARIO/public_html
#   Domínio adicional → /home3/USUARIO/nome-do-dominio
DESTINO="/home3/USUARIO/public_html"
