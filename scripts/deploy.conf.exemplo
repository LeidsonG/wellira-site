# Credenciais do deploy — copie para deploy.conf na RAIZ do projeto.
#
# deploy.conf está no .gitignore. Nunca versione o arquivo preenchido:
# o repositório é público.
#
# A SENHA NÃO ENTRA AQUI de propósito. O script pergunta na hora, para que ela
# não fique salva em disco nem no histórico do shell. Se precisar automatizar,
# exporte FTP_SENHA no ambiente antes de rodar.

FTP_USUARIO="leidson@wellira.online"
FTP_HOST="ftp.wellira.online"

# FTPS explícito (AUTH TLS) na 21. O script recusa conexão sem criptografia.
FTP_PORTA="21"

# Raiz pública, do ponto de vista DESTA conta de FTP.
#
# Confira antes do primeiro deploy: contas de FTP criadas no cPanel costumam
# já cair dentro de public_html, e nesse caso o destino é "/". Se a conta cair
# no /home do usuário, use "/public_html".
#
# Para descobrir (note os dois "set", sem eles o lftp para no certificado):
#   lftp -u "leidson@wellira.online" -p 21 ftp.wellira.online \
#     -e "set ssl:check-hostname no; set ssl:verify-certificate yes; pwd; ls; bye"
DESTINO="/"
